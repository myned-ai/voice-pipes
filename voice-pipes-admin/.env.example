# Copy to .env next to docker-compose.yml.  .env is git-ignored.

# Token the admin UI must present to the admin backend (port 8000).
# Generate one:  openssl rand -hex 32
ADMIN_UI_TOKEN=

# Token the admin backend presents to the orchestrator (port 9090).
# Must equal the VP_ADMIN_TOKEN the orchestrator was started with.  Leave
# empty only when the orchestrator runs without auth (dev).
VP_ADMIN_TOKEN=

# Optional: set to true to unlock full production/FinOps/SRE telemetry charts
# on the Dashboard (defaults to false for the streamlined v1 developer view).
# VITE_DASHBOARD_PRODUCTION_MODE=false

