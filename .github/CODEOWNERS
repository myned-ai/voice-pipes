# Who must review a change, by path. The last matching line wins.
#
# Each provider crate has its own entry, so vendor and model code can be
# given its own owners without making the engine's owners review it, and
# the contracts and supply-chain policy keep a named reviewer.

*                               @goran-j

# Contracts and shared infrastructure: every provider builds on these.
/voice-pipes-sdk/               @goran-j
/voice-pipes-onnx/              @goran-j
/voice-pipes-net/               @goran-j

# Runtime and composition.
/voice-pipes/                   @goran-j
/voice-pipes-cli/               @goran-j
/voice-pipes-gym/               @goran-j

# Providers, one line each.
/plugins/stt/google/            @goran-j
/plugins/stt/parakeet/          @goran-j
/plugins/tts/piper/             @goran-j
/plugins/vad/silero/            @goran-j
/plugins/stt/moonshine/         @goran-j
/plugins/stt/nemotron/          @goran-j
/plugins/stt/nemotron35/        @goran-j
/plugins/tts/kokoro/            @goran-j
/plugins/tts/pocket/            @goran-j
/plugins/tts/openai/            @goran-j
/plugins/stt/assemblyai/        @goran-j
/plugins/tts/elevenlabs/        @goran-j
/plugins/tts/gemini/            @goran-j
/plugins/llm/openai-compat/     @goran-j
/plugins/llm/gguf/              @goran-j
/plugins/s2s/openai/            @goran-j
/plugins/s2s/gemini/            @goran-j
/plugins/s2s/elevenlabs/        @goran-j
/plugins/turn/smart/            @goran-j
/plugins/turn/vap/              @goran-j
/plugins/filter/deepfilter/     @goran-j

# Supply-chain policy and the gates that enforce it.
/deny.toml                      @goran-j
/Cargo.toml                     @goran-j
/Cargo.lock                     @goran-j
/scripts/dep-budget.*           @goran-j
/.github/                       @goran-j
